import std.string
import std.collections
from std.test import assert_eq_str, assert_eq_int, assert_true, assert_msg
from "./lib" import parse, Toml, Value

fun toml(text: str) -> Toml {
    return match parse(text) {
        case Ok(t) { t }
        case Err(e) {
            assert_msg(false, e.to_string())
            let d: dict[str, Value] = Map.new()
            Toml(data: d)
        }
    }
}

fun test_scalars() {
    let t = toml("name = \"raven\"\nport = 8080\nratio = 1.5\ndebug = true\n")
    assert_eq_str(t.get_string_or("name", ""), "raven")
    assert_eq_int(t.get_int_or("port", 0), 8080)
    assert_true(t.get_bool_or("debug", false))
    match t.get_float("ratio") {
        case Some(f) { assert_true(f > 1.0) }
        case None { assert_msg(false, "ratio") }
    }
}

fun test_tables() {
    let t = toml("[server]\nhost = \"0.0.0.0\"\nport = 80\n[db]\nname = \"app\"\n")
    assert_eq_str(t.get_string_or("server.host", ""), "0.0.0.0")
    assert_eq_int(t.get_int_or("server.port", 0), 80)
    assert_eq_str(t.get_string_or("db.name", ""), "app")
}

fun test_string_escapes() {
    assert_eq_str(toml("msg = \"a\\nb\"\n").get_string_or("msg", ""), "a\nb")
}

fun test_comments() {
    let t = toml("# header\nkey = \"value\"  # trailing\nhash = \"a#b\"\n")
    assert_eq_str(t.get_string_or("key", ""), "value")
    assert_eq_str(t.get_string_or("hash", ""), "a#b")
}

fun test_arrays() {
    let t = toml("nums = [1, 2, 3]\nwords = [\"a\", \"b\"]\n")
    match t.get_array("nums") {
        case Some(xs) { assert_eq_int(xs.len(), 3) }
        case None { assert_msg(false, "nums") }
    }
    match t.get_array("words") {
        case Some(xs) { assert_eq_int(xs.len(), 2) }
        case None { assert_msg(false, "words") }
    }
}

fun test_wrong_type_returns_none() {
    let t = toml("port = 8080\n")
    match t.get_string("port") {
        case Some(s) { assert_msg(false, "should be none") }
        case None { assert_true(true) }
    }
    assert_eq_str(t.get_string_or("port", "default"), "default")
}

fun test_default_when_missing() {
    assert_eq_int(toml("x = 1\n").get_int_or("missing", 99), 99)
}

fun test_unterminated_string_errors() {
    match parse("x = \"oops\n") {
        case Ok(t) { assert_msg(false, "expected error") }
        case Err(e) { assert_true(e.message.contains("unterminated")) }
    }
}

fun test_bare_value_errors() {
    match parse("x = localhost\n") {
        case Ok(t) { assert_msg(false, "expected error") }
        case Err(e) { assert_true(e.message.contains("quotes")) }
    }
}

fun test_array_of_tables() {
    let src = "[[plugin]]\nname = \"fmt\"\nargs = [\"fmt\", \"{file}\"]\n\n[[plugin]]\nname = \"sort\"\n"
    let t = parse(src).unwrap()
    let ps = t.tables("plugin")
    assert_eq_int(ps.len(), 2)
    assert_eq_str(ps[0].get_string_or("name", ""), "fmt")
    assert_eq_int(ps[0].get_strings("args").len(), 2)
    assert_eq_str(ps[1].get_string_or("name", ""), "sort")
    assert_eq_int(t.tables("missing").len(), 0)
}

fun test_quoted_keys_and_listing() {
    let src = "[keys]\n\"ctrl+s\" = \"save\"\n\"a = b\" = \"odd\"\ngg = \"top\"\n[keys.insert]\nx = \"y\"\n"
    let t = parse(src).unwrap()
    assert_eq_str(t.get_string_or("keys.ctrl+s", ""), "save")
    assert_eq_str(t.get_string_or("keys.a = b", ""), "odd")
    let ks = t.keys("keys")
    assert_eq_int(ks.len(), 3)
    assert_eq_str(ks[0], "ctrl+s")
    assert_eq_str(ks[2], "gg")
    assert_eq_int(t.keys("keys.insert").len(), 1)
}

fun test_keys_under_keeps_dotted_names() {
    let t = parse(
        "[colors]\n\"ui.bg\" = \"#000000\"\nkeyword = \"#ffffff\"\n[colors.mode]\nnormal = \"#111111\"\n",
    ).unwrap()
    let ks = t.keys_under("colors")
    assert_eq_int(ks.len(), 3)
    assert_eq_str(ks[0], "ui.bg")
    assert_eq_str(ks[2], "mode.normal")
    assert_eq_str(t.get_string_or("colors.${ks[0]}", ""), "#000000")
    assert_eq_int(t.keys("colors").len(), 1)
}

fun test_escaped_quote_before_comment() {
    let t = parse("s = \"a\\\"b\" # note\n").unwrap()
    assert_eq_str(t.get_string_or("s", ""), "a\"b")
}
