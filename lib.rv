// raven-toml: parse a practical subset of TOML for Raven.
//
//     import "github.com/martian56/raven-toml" { parse }
//
//     match parse(text) {
//         Ok(t) -> {
//             let host = t.get_string_or("server.host", "localhost")
//             let port = t.get_int_or("server.port", 8080)
//         },
//         Err(e) -> print(e.to_string()),
//     }
//
// Supported: [tables] and [dotted.tables], key = value, # comments, and the
// scalar types string (double-quoted, with \n \t \r escapes), integer, float,
// and bool, plus arrays of those. Values are addressed by their dotted path.

import std/string
import std/collections

// A TOML value. Arrays nest, so `Array` holds more `Value`s.
enum Value {
    Str(String),
    Int(Int),
    Float(Float),
    Bool(Bool),
    Array(List<Value>),
}

// A parse error, with the 1-based line.
struct TomlError {
    line: Int,
    message: String,
}

impl TomlError {
    fun new(line: Int, message: String) -> TomlError {
        return TomlError { line, message }
    }
}

impl ToString for TomlError {
    fun to_string(self) -> String {
        return "toml:${self.line}: ${self.message}"
    }
}

// A parsed document. Values are addressed by their dotted path, for example
// "server.host" or, at the top level, just "title".
struct Toml {
    data: Map<String, Value>,
}

impl Toml {
    fun get(self, key: String) -> Option<Value> {
        return self.data.get(key)
    }

    fun has(self, key: String) -> Bool {
        return self.data.has(key)
    }

    fun get_string(self, key: String) -> Option<String> {
        return match self.data.get(key) {
            Some(v) -> match v {
                Str(s) -> Some(s),
                Int(n) -> None,
                Float(f) -> None,
                Bool(b) -> None,
                Array(xs) -> None,
            },
            None -> None,
        }
    }

    fun get_string_or(self, key: String, fallback: String) -> String {
        return match self.get_string(key) {
            Some(s) -> s,
            None -> fallback,
        }
    }

    fun get_int(self, key: String) -> Option<Int> {
        return match self.data.get(key) {
            Some(v) -> match v {
                Int(n) -> Some(n),
                Str(s) -> None,
                Float(f) -> None,
                Bool(b) -> None,
                Array(xs) -> None,
            },
            None -> None,
        }
    }

    fun get_int_or(self, key: String, fallback: Int) -> Int {
        return match self.get_int(key) {
            Some(n) -> n,
            None -> fallback,
        }
    }

    fun get_float(self, key: String) -> Option<Float> {
        return match self.data.get(key) {
            Some(v) -> match v {
                Float(f) -> Some(f),
                Str(s) -> None,
                Int(n) -> None,
                Bool(b) -> None,
                Array(xs) -> None,
            },
            None -> None,
        }
    }

    fun get_bool(self, key: String) -> Option<Bool> {
        return match self.data.get(key) {
            Some(v) -> match v {
                Bool(b) -> Some(b),
                Str(s) -> None,
                Int(n) -> None,
                Float(f) -> None,
                Array(xs) -> None,
            },
            None -> None,
        }
    }

    fun get_bool_or(self, key: String, fallback: Bool) -> Bool {
        return match self.get_bool(key) {
            Some(b) -> b,
            None -> fallback,
        }
    }

    fun get_array(self, key: String) -> Option<List<Value>> {
        return match self.data.get(key) {
            Some(v) -> match v {
                Array(xs) -> Some(xs),
                Str(s) -> None,
                Int(n) -> None,
                Float(f) -> None,
                Bool(b) -> None,
            },
            None -> None,
        }
    }
}

fun parse(text: String) -> Result<Toml, TomlError> {
    let data: Map<String, Value> = Map.new()
    let current = ""
    let lines = text.lines()
    let i = 0
    while i < lines.len() {
        let line = _strip_comment(lines[i]).trim()
        let lineno = i + 1
        if line == "" {
            i += 1
        } else if line.starts_with("[") {
            if !line.ends_with("]") {
                return Err(TomlError.new(lineno, "malformed table header"))
            }
            current = line.substring(1, line.length() - 1).trim()
            i += 1
        } else {
            let eq = line.index_of("=")
            if eq < 0 {
                return Err(TomlError.new(lineno, "expected key = value"))
            }
            let key = line.substring(0, eq).trim()
            if key == "" {
                return Err(TomlError.new(lineno, "empty key"))
            }
            match _parse_value(line.substring(eq + 1, line.length()), lineno) {
                Ok(v) -> {
                    let full = key
                    if current != "" {
                        full = "${current}.${key}"
                    }
                    data.set(full, v)
                },
                Err(e) -> {
                    return Err(e)
                },
            }
            i += 1
        }
    }
    return Ok(Toml { data })
}

fun _parse_value(s: String, lineno: Int) -> Result<Value, TomlError> {
    let t = s.trim()
    if t == "" {
        return Err(TomlError.new(lineno, "missing value"))
    }
    let first = t.char_at(0)
    if first == "\"" {
        return _parse_string(t, lineno)
    }
    if t == "true" {
        return Ok(Value.Bool(true))
    }
    if t == "false" {
        return Ok(Value.Bool(false))
    }
    if first == "[" {
        return _parse_array(t, lineno)
    }
    match t.parse_int() {
        Some(n) -> {
            return Ok(Value.Int(n))
        },
        None -> {},
    }
    match t.parse_float() {
        Some(f) -> {
            return Ok(Value.Float(f))
        },
        None -> {},
    }
    return Err(TomlError.new(lineno, "unrecognized value (strings need quotes)"))
}

fun _parse_string(t: String, lineno: Int) -> Result<Value, TomlError> {
    let n = t.length()
    let i = 1
    let out = ""
    while i < n {
        let c = t.char_at(i)
        if c == "\"" {
            return Ok(Value.Str(out))
        }
        if c == "\\" && i + 1 < n {
            out = out.concat(_unescape(t.char_at(i + 1)))
            i += 2
        } else {
            out = out.concat(c)
            i += 1
        }
    }
    return Err(TomlError.new(lineno, "unterminated string"))
}

fun _parse_array(t: String, lineno: Int) -> Result<Value, TomlError> {
    if !t.ends_with("]") {
        return Err(TomlError.new(lineno, "unterminated array"))
    }
    let inner = t.substring(1, t.length() - 1).trim()
    let items: List<Value> = []
    if inner == "" {
        return Ok(Value.Array(items))
    }
    let parts = _split_commas(inner)
    let i = 0
    while i < parts.len() {
        match _parse_value(parts[i], lineno) {
            Ok(v) -> {
                items.push(v)
            },
            Err(e) -> {
                return Err(e)
            },
        }
        i += 1
    }
    return Ok(Value.Array(items))
}

fun _split_commas(s: String) -> List<String> {
    let out: List<String> = []
    let cur = ""
    let in_q = false
    let depth = 0
    let i = 0
    while i < s.length() {
        let c = s.char_at(i)
        if c == "\"" {
            in_q = !in_q
            cur = cur.concat(c)
        } else if c == "[" && !in_q {
            depth += 1
            cur = cur.concat(c)
        } else if c == "]" && !in_q {
            depth -= 1
            cur = cur.concat(c)
        } else if c == "," && !in_q && depth == 0 {
            out.push(cur)
            cur = ""
        } else {
            cur = cur.concat(c)
        }
        i += 1
    }
    if cur.trim() != "" {
        out.push(cur)
    }
    return out
}

fun _strip_comment(line: String) -> String {
    let in_q = false
    let i = 0
    while i < line.length() {
        let c = line.char_at(i)
        if c == "\"" {
            in_q = !in_q
        } else if c == "#" && !in_q {
            return line.substring(0, i)
        }
        i += 1
    }
    return line
}

fun _unescape(c: String) -> String {
    if c == "n" {
        return "\n"
    }
    if c == "t" {
        return "\t"
    }
    if c == "r" {
        return "\r"
    }
    if c == "\"" {
        return "\""
    }
    if c == "\\" {
        return "\\"
    }
    return "\\".concat(c)
}
