// raven-toml: parse a practical subset of TOML for Raven.
//
//     from "github.com/martian56/raven-toml" import parse
//
//     match parse(text) {
//         case Ok(t) {
//             let host = t.get_string_or("server.host", "localhost")
//             let port = t.get_int_or("server.port", 8080)
//         }
//         case Err(e) { print(e.to_string()) }
//     }
//
// Supported: [tables], [dotted.tables], [[arrays.of.tables]], bare and quoted
// keys, key = value, # comments, and the
// scalar types string (double-quoted, with \n \t \r escapes), integer, float,
// and bool, plus arrays of those. Values are addressed by their dotted path.

import std.string
import std.collections

// A TOML value. Arrays nest, so `Array` holds more `Value`s.
enum Value {
    Str(str),
    Int(int),
    Float(float),
    Bool(bool),
    Array(list[Value]),
}

// A parse error, with the 1-based line.
class TomlError {
    line: int
    message: str
}

impl TomlError {
    fun new(line: int, message: str) -> TomlError {
        return TomlError(line: line, message: message)
    }
}

impl ToString for TomlError {
    fun to_string(self) -> str {
        return "toml:${self.line}: ${self.message}"
    }
}

// A parsed document. Values are addressed by their dotted path, for example
// "server.host" or, at the top level, just "title".
class Toml {
    data: dict[str, Value]
    // Every key in file order, for listing a table's keys.
    order: list[str] = []
    // How many `[[name]]` entries each array of tables has.
    counts: dict[str, int] = {}
}

impl Toml {
    // The keys directly inside `table` (`""` for the top level), without the
    // table prefix, in file order. Nested tables are not listed.
    fun keys(self, table: str) -> list[str] {
        let prefix = "" if table == "" else table + "."
        let out: list[str] = []
        for full in self.order {
            if full.starts_with(prefix) {
                let rest = full.substring(prefix.length(), full.length())
                if rest.index_of(".") < 0 {
                    out.push(rest)
                }
            }
        }
        return out
    }

    // Every key beneath `table`, without the table prefix, in file order. Unlike
    // `keys`, a dotted remainder is kept whole: `"ui.bg" = ...` inside
    // `[colors]` lists as `ui.bg`, and so does `bg` inside `[colors.ui]`.
    fun keys_under(self, table: str) -> list[str] {
        let prefix = "" if table == "" else table + "."
        let out: list[str] = []
        for full in self.order {
            if full.starts_with(prefix) {
                out.push(full.substring(prefix.length(), full.length()))
            }
        }
        return out
    }

    // Each `[[name]]` entry as its own Toml, in file order. Empty when the
    // file has none.
    fun tables(self, name: str) -> list[Toml] {
        let out: list[Toml] = []
        let n = self.counts.get(name).unwrap_or(0)
        var idx = 0
        while idx < n {
            let prefix = "${name}.${idx}."
            let data: dict[str, Value] = {}
            let order: list[str] = []
            for full in self.order {
                if full.starts_with(prefix) {
                    let rest = full.substring(prefix.length(), full.length())
                    data.set(rest, self.data.get(full).unwrap())
                    order.push(rest)
                }
            }
            let counts: dict[str, int] = {}
            out.push(Toml(data: data, order: order, counts: counts))
            idx += 1
        }
        return out
    }

    // An array of strings, skipping non-string items. Empty when absent.
    fun get_strings(self, key: str) -> list[str] {
        let out: list[str] = []
        match self.get_array(key) {
            case Some(xs) {
                for x in xs {
                    match x {
                        case Str(s) { out.push(s) }
                        case _ {}
                    }
                }
            }
            case None {}
        }
        return out
    }

    fun get(self, key: str) -> Option[Value] {
        return self.data.get(key)
    }

    fun has(self, key: str) -> bool {
        return self.data.has(key)
    }

    fun get_string(self, key: str) -> Option[str] {
        return match self.data.get(key) {
            case Some(v) {
                match v {
                    case Str(s) { Some(s) }
                    case Int(n) { None }
                    case Float(f) { None }
                    case Bool(b) { None }
                    case Array(xs) { None }
                }
            }
            case None { None }
        }
    }

    fun get_string_or(self, key: str, fallback: str) -> str {
        return match self.get_string(key) {
            case Some(s) { s }
            case None { fallback }
        }
    }

    fun get_int(self, key: str) -> Option[int] {
        return match self.data.get(key) {
            case Some(v) {
                match v {
                    case Int(n) { Some(n) }
                    case Str(s) { None }
                    case Float(f) { None }
                    case Bool(b) { None }
                    case Array(xs) { None }
                }
            }
            case None { None }
        }
    }

    fun get_int_or(self, key: str, fallback: int) -> int {
        return match self.get_int(key) {
            case Some(n) { n }
            case None { fallback }
        }
    }

    fun get_float(self, key: str) -> Option[float] {
        return match self.data.get(key) {
            case Some(v) {
                match v {
                    case Float(f) { Some(f) }
                    case Str(s) { None }
                    case Int(n) { None }
                    case Bool(b) { None }
                    case Array(xs) { None }
                }
            }
            case None { None }
        }
    }

    fun get_bool(self, key: str) -> Option[bool] {
        return match self.data.get(key) {
            case Some(v) {
                match v {
                    case Bool(b) { Some(b) }
                    case Str(s) { None }
                    case Int(n) { None }
                    case Float(f) { None }
                    case Array(xs) { None }
                }
            }
            case None { None }
        }
    }

    fun get_bool_or(self, key: str, fallback: bool) -> bool {
        return match self.get_bool(key) {
            case Some(b) { b }
            case None { fallback }
        }
    }

    fun get_array(self, key: str) -> Option[list[Value]] {
        return match self.data.get(key) {
            case Some(v) {
                match v {
                    case Array(xs) { Some(xs) }
                    case Str(s) { None }
                    case Int(n) { None }
                    case Float(f) { None }
                    case Bool(b) { None }
                }
            }
            case None { None }
        }
    }
}

fun parse(text: str) -> Result[Toml, TomlError] {
    let data: dict[str, Value] = {}
    let order: list[str] = []
    let counts: dict[str, int] = {}
    var current = ""
    let lines = text.lines()
    var i = 0
    while i < lines.len() {
        let line = _strip_comment(lines[i]).trim()
        let lineno = i + 1
        if line == "" {
            i += 1
        } else if line.starts_with("[[") {
            if not line.ends_with("]]") {
                return Err(TomlError.new(lineno, "malformed array-of-tables header"))
            }
            let name = line.substring(2, line.length() - 2).trim()
            let n = counts.get(name).unwrap_or(0)
            counts.set(name, n + 1)
            current = "${name}.${n}"
            i += 1
        } else if line.starts_with("[") {
            if not line.ends_with("]") {
                return Err(TomlError.new(lineno, "malformed table header"))
            }
            current = line.substring(1, line.length() - 1).trim()
            i += 1
        } else {
            let eq = _key_end(line)
            if eq < 0 {
                return Err(TomlError.new(lineno, "expected key = value"))
            }
            let key = _unquote_key(line.substring(0, eq).trim())
            if key == "" {
                return Err(TomlError.new(lineno, "empty key"))
            }
            match _parse_value(line.substring(eq + 1, line.length()), lineno) {
                case Ok(v) {
                    var full = key
                    if current != "" {
                        full = "${current}.${key}"
                    }
                    if not data.has(full) {
                        order.push(full)
                    }
                    data.set(full, v)
                }
                case Err(e) {
                    return Err(e)
                }
            }
            i += 1
        }
    }
    return Ok(Toml(data: data, order: order, counts: counts))
}

// The index of the `=` that ends the key, skipping a quoted key's contents.
fun _key_end(line: str) -> int {
    if line.starts_with("\"") {
        var i = 1
        while i < line.length() {
            let c = line.char_at(i)
            if c == "\\" {
                i += 2
            } else if c == "\"" {
                let rest = line.substring(i + 1, line.length())
                let eq = rest.index_of("=")
                return -1 if eq < 0 else i + 1 + eq
            } else {
                i += 1
            }
        }
        return -1
    }
    return line.index_of("=")
}

// `"ctrl+s"` as a key is `ctrl+s`.
fun _unquote_key(key: str) -> str {
    if key.length() >= 2 and key.starts_with("\"") and key.ends_with("\"") {
        return key.substring(1, key.length() - 1)
    }
    return key
}

fun _parse_value(s: str, lineno: int) -> Result[Value, TomlError] {
    let t = s.trim()
    if t == "" {
        return Err(TomlError.new(lineno, "missing value"))
    }
    let first = t.char_at(0)
    if first == "\"" {
        return _parse_string(t, lineno)
    }
    if t == "true" {
        return Ok(Value.Bool(true))
    }
    if t == "false" {
        return Ok(Value.Bool(false))
    }
    if first == "[" {
        return _parse_array(t, lineno)
    }
    match t.parse_int() {
        case Some(n) {
            return Ok(Value.Int(n))
        }
        case None {}
    }
    match t.parse_float() {
        case Some(f) {
            return Ok(Value.Float(f))
        }
        case None {}
    }
    return Err(TomlError.new(lineno, "unrecognized value (strings need quotes)"))
}

fun _parse_string(t: str, lineno: int) -> Result[Value, TomlError] {
    let n = t.length()
    var i = 1
    var out = ""
    while i < n {
        let c = t.char_at(i)
        if c == "\"" {
            return Ok(Value.Str(out))
        }
        if c == "\\" and i + 1 < n {
            out = out.concat(_unescape(t.char_at(i + 1)))
            i += 2
        } else {
            out = out.concat(c)
            i += 1
        }
    }
    return Err(TomlError.new(lineno, "unterminated string"))
}

fun _parse_array(t: str, lineno: int) -> Result[Value, TomlError] {
    if not t.ends_with("]") {
        return Err(TomlError.new(lineno, "unterminated array"))
    }
    let inner = t.substring(1, t.length() - 1).trim()
    let items: list[Value] = []
    if inner == "" {
        return Ok(Value.Array(items))
    }
    let parts = _split_commas(inner)
    var i = 0
    while i < parts.len() {
        match _parse_value(parts[i], lineno) {
            case Ok(v) { items.push(v) }
            case Err(e) {
                return Err(e)
            }
        }
        i += 1
    }
    return Ok(Value.Array(items))
}

fun _split_commas(s: str) -> list[str] {
    let out: list[str] = []
    var cur = ""
    var in_q = false
    var depth = 0
    var i = 0
    while i < s.length() {
        let c = s.char_at(i)
        if c == "\"" {
            in_q = not in_q
            cur = cur.concat(c)
        } else if c == "[" and not in_q {
            depth += 1
            cur = cur.concat(c)
        } else if c == "]" and not in_q {
            depth -= 1
            cur = cur.concat(c)
        } else if c == "," and not in_q and depth == 0 {
            out.push(cur)
            cur = ""
        } else {
            cur = cur.concat(c)
        }
        i += 1
    }
    if cur.trim() != "" {
        out.push(cur)
    }
    return out
}

fun _strip_comment(line: str) -> str {
    var in_q = false
    var i = 0
    while i < line.length() {
        let c = line.char_at(i)
        if c == "\\" and in_q {
            i += 1
        } else if c == "\"" {
            in_q = not in_q
        } else if c == "#" and not in_q {
            return line.substring(0, i)
        }
        i += 1
    }
    return line
}

fun _unescape(c: str) -> str {
    if c == "n" {
        return "\n"
    }
    if c == "t" {
        return "\t"
    }
    if c == "r" {
        return "\r"
    }
    if c == "\"" {
        return "\""
    }
    if c == "\\" {
        return "\\"
    }
    return "\\".concat(c)
}
