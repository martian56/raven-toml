// Build and run: raven build demo.rv -o demo && ./demo
import std/io { println }
import std/string
import "./lib" { parse }

fun main() {
    let text = "title = \"Raven Config\"\n\n[server]\nhost = \"0.0.0.0\"\nport = 8080\ndebug = true\n\n[limits]\nratio = 0.75\n"
    match parse(text) {
        Ok(cfg) -> {
            println("title:  ".concat(cfg.get_string_or("title", "")))
            println(
                "server: ".concat(cfg.get_string_or("server.host", "")).concat(":").concat(
                    cfg.get_int_or("server.port", 0).to_string(),
                ),
            )
            if cfg.get_bool_or("server.debug", false) {
                println("debug:  on")
            }
        },
        Err(e) -> println(e.to_string()),
    }
}
